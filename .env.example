POSTGRES_DB=kotlin_template
POSTGRES_USER=kotlin_template
POSTGRES_PASSWORD=kotlin_template
POSTGRES_PORT=5432
# Native commands (./gradlew run, the API and worker started from an IDE)
# connect with this URL. Compose gives its containers their own; the
# PostgreSQL tests start their own database.
DATABASE_URL=postgresql://kotlin_template:kotlin_template@127.0.0.1:5432/kotlin_template
DATABASE_STATEMENT_TIMEOUT_MS=10000
API_HOST=127.0.0.1
API_PORT=8000
WORKER_POLL_INTERVAL_MS=5000
WORKER_PASS_TIMEOUT_MS=60000
# trace, debug, info, warn, error or off. debug adds a line per worker pass.
LOG_LEVEL=info
